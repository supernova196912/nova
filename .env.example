# Solo para el servidor local. En Cloudflare Pages define TMDB_API_KEY como Secret.
TMDB_API_KEY=

# URL pública de Cloudflare Pages; se empaqueta como dirección, nunca como secreto.
# Reemplaza el ejemplo por la URL real antes de compilar la app Android.
CINENOVA_API_BASE_URL=https://tu-proyecto.pages.dev

# Orígenes extra permitidos para llamadas desde la app/web; separados por coma.
CINENOVA_ALLOWED_ORIGINS=https://tu-proyecto.pages.dev,https://localhost,http://localhost,capacitor://localhost
